# Copy to .env and fill in what you have. Every variable here is
# optional: with none of them set the pipeline runs end to end, publishes
# in dry-run, and reports metrics as SIMULATED. Nothing in this file
# belongs in config/config.yaml or in git.

# --- YouTube: the only real retention curve in the system -------------
# Data API v3 + Analytics API v2. Analytics reads are free; a video read
# costs 1 quota unit. This is what turns report metrics from SIMULATED
# into REAL. See docs/GERCEK-VERI.md for the OAuth walkthrough.
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# --- corporate TLS interception ---------------------------------------
# If your network re-signs TLS, point this at the proxy root certificate.
# YVC_INSECURE_TLS=1 also exists; it disables verification and logs a
# loud warning every run. Prefer the bundle.
# YVC_CA_BUNDLE=C:/path/to/corporate-root.pem
